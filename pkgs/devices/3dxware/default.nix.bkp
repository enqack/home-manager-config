{ lib, pkgs, stdenv, fetchzip }:

stdenv.mkDerivation {
  pname = "3dxware";
  version = "1.8.0";

  src = fetchzip {
    url = "https://download.3dconnexion.com/drivers/linux/3dxware-linux-v1-8-0.x86_64.tar.gz";
    sha256 = "sha256-qVSOEoJEmOdhrk0PJffp/2ch5hD/v1oj35bm3XDfnRk=";
    stripRoot = false;
  };

  buildInputs = [ pkgs.motif pkgs.glibc ];

  installPhase = ''
    mkdir -p $out/bin $out/usr/share/3DxWare $out/etc

    mv etc/3DxWare/daemon/3dxsrv $out/bin
    cp -r etc/. $out/etc/.
    rmdir $out/etc/3DxWare/daemon

    cp -r etc/3DxWare/resource/. $out/usr/share/3DxWare
    rm -rf $out/etc/3DxWare/resource

    # Create shim lib dir and symlink libXm.so.3 -> libXm.so.4
    mkdir -p $out/lib
    ln -s ${pkgs.motif}/lib/libXm.so.4 $out/lib/libXm.so.3
  '';

  postInstall = ''
    # Patch binary to use the fake lib path first
    patchelf --set-interpreter ${pkgs.glibc}/lib/ld-linux-x86-64.so.2 $out/bin/3dxsrv
    patchelf --set-rpath $out/lib:${pkgs.motif}/lib:${pkgs.glibc}/lib $out/bin/3dxsrv
  '';
}
